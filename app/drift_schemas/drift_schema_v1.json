  "fixed_sql": [
    {
      "name": "groups",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"groups\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"owner_id\" TEXT NOT NULL, \"mountain\" TEXT NULL, \"key_version\" INTEGER NOT NULL DEFAULT 1, \"created_at_utc\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "members",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"members\" (\"group_id\" TEXT NOT NULL REFERENCES \"groups\" (id) ON DELETE CASCADE, \"user_id\" TEXT NOT NULL, \"username\" TEXT NOT NULL, \"role\" TEXT NOT NULL DEFAULT 'member', \"joined_at_utc\" TEXT NOT NULL, PRIMARY KEY (\"group_id\", \"user_id\"), CHECK (role IN ('owner', 'member')));"
        }
      ]
    },
    {
      "name": "invitations",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"invitations\" (\"id\" TEXT NOT NULL, \"group_id\" TEXT NOT NULL, \"inviter_id\" TEXT NOT NULL, \"invitee_username\" TEXT NOT NULL, \"status\" TEXT NOT NULL DEFAULT 'pending', \"created_at_utc\" TEXT NOT NULL, \"expires_at_utc\" TEXT NOT NULL, PRIMARY KEY (\"id\"), CHECK (status IN ('pending', 'accepted', 'rejected', 'expired', 'cancelled')));"
        }
      ]
    },
    {
      "name": "messages",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"messages\" (\"id\" TEXT NOT NULL, \"author_id\" TEXT NOT NULL, \"seq\" INTEGER NOT NULL, \"group_id\" TEXT NOT NULL, \"type_code\" INTEGER NOT NULL, \"sent_at_utc\" TEXT NOT NULL, \"received_at_utc\" TEXT NOT NULL, \"payload\" BLOB NOT NULL, \"signature\" BLOB NULL, \"is_outgoing\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_outgoing\" IN (0, 1)), PRIMARY KEY (\"id\"), UNIQUE (\"author_id\", \"seq\"));"
        }
      ]
    },
    {
      "name": "media",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"media\" (\"id\" TEXT NOT NULL, \"message_id\" TEXT NULL REFERENCES messages (id) ON DELETE SET NULL, \"group_id\" TEXT NULL, \"kind\" TEXT NOT NULL, \"relative_path\" TEXT NOT NULL, \"mime_type\" TEXT NOT NULL, \"byte_size\" INTEGER NOT NULL, \"created_at_utc\" TEXT NOT NULL, PRIMARY KEY (\"id\"), CHECK (kind IN ('image', 'audio', 'video', 'file')), CHECK (byte_size >= 0));"
        }
      ]
    },
    {
      "name": "sessions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sessions\" (\"id\" TEXT NOT NULL, \"started_at_utc\" TEXT NOT NULL, \"ended_at_utc\" TEXT NULL, \"group_id\" TEXT NULL, \"trail_id\" TEXT NULL, \"distance_m\" REAL NOT NULL DEFAULT 0.0, \"moving_seconds\" INTEGER NOT NULL DEFAULT 0, \"elevation_gain_m\" REAL NOT NULL DEFAULT 0.0, \"elevation_loss_m\" REAL NOT NULL DEFAULT 0.0, \"status\" TEXT NOT NULL DEFAULT 'active', PRIMARY KEY (\"id\"), CHECK (distance_m >= 0), CHECK (moving_seconds >= 0), CHECK (elevation_gain_m >= 0), CHECK (elevation_loss_m >= 0), CHECK (status IN ('active', 'completed')));"
        }
      ]
    },
    {
      "name": "track_points",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"track_points\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"session_id\" TEXT NOT NULL REFERENCES sessions (id) ON DELETE CASCADE, \"lat\" REAL NOT NULL, \"lon\" REAL NOT NULL, \"altitude_m\" REAL NULL, \"accuracy_m\" REAL NOT NULL, \"speed_mps\" REAL NULL, \"recorded_at_utc\" TEXT NOT NULL, CHECK (lat BETWEEN -90 AND 90), CHECK (lon BETWEEN -180 AND 180));"
        }
      ]
    },
    {
      "name": "outbox",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"outbox\" (\"message_id\" TEXT NOT NULL, \"packet\" BLOB NOT NULL, \"priority\" INTEGER NOT NULL, \"enqueued_at_utc\" TEXT NOT NULL, \"next_attempt_at_utc\" TEXT NOT NULL, \"attempts\" INTEGER NOT NULL DEFAULT 0, \"repeat_until_ack\" INTEGER NOT NULL DEFAULT 0 CHECK (\"repeat_until_ack\" IN (0, 1)), PRIMARY KEY (\"message_id\"), CHECK (priority >= 0), CHECK (attempts >= 0));"
        }
      ]
    },
    {
      "name": "sos_events",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sos_events\" (\"id\" TEXT NOT NULL, \"author_id\" TEXT NOT NULL, \"group_id\" TEXT NULL REFERENCES \"groups\" (id) ON DELETE SET NULL, \"category_code\" INTEGER NOT NULL, \"lat\" REAL NOT NULL, \"lon\" REAL NOT NULL, \"accuracy_m\" INTEGER NULL, \"battery_percent\" INTEGER NULL, \"created_at_utc\" TEXT NOT NULL, \"received_at_utc\" TEXT NOT NULL, \"status\" TEXT NOT NULL DEFAULT 'active', \"cancelled_at_utc\" TEXT NULL, PRIMARY KEY (\"id\"), CHECK (lat BETWEEN -90 AND 90), CHECK (lon BETWEEN -180 AND 180), CHECK (status IN ('active', 'cancelled', 'resolved')));"
