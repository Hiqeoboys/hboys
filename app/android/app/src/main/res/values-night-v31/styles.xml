<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Mirrors values-v31 so Dark OS mode on Android 12+ never shadows values-v31 -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/hiqeo_splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@color/hiqeo_splash_background</item>
        <item name="android:navigationBarColor">@color/hiqeo_splash_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/hiqeo_splash_background</item>
    </style>
</resources>
