# ============================================================
# Altracq — hanya berkas penting yang didorong ke remote.
# Prinsip: kode sumber, konfigurasi build, data jalur, dokumen.
# Bukan: artefak build, cache, log, screenshot, kredensial.
# ============================================================

# --- Rahasia & berkas lokal (jangan pernah di-commit) ---
.run-artifacts/
keys.local.json
*.local.json
.env
.env.*
*.keystore
*.jks
key.properties
google-services.json
GoogleService-Info.plist

# --- Artefak build & cache Dart/Flutter ---
**/build/
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.packages
**/pubspec_overrides.yaml
app/l10n/generated/

# --- Android: berkas mesin lokal ---
app/android/local.properties
app/android/.gradle/
app/android/app/debug/
app/android/app/profile/
app/android/app/release/
**/*.apk
**/*.aab

# --- iOS: berkas hasil generate & pods ---
app/ios/Flutter/Generated.xcconfig
app/ios/Flutter/ephemeral/
app/ios/Flutter/flutter_export_environment.sh
app/ios/Pods/
app/ios/.symlinks/
app/ios/Flutter/App.framework
app/ios/Flutter/Flutter.framework
app/ios/Flutter/Flutter.podspec
**/*.mode1v3
**/*.mode2v3
**/*.perspectivev3
**/xcuserdata/
**/DerivedData/

# --- IDE & editor ---
.idea/
.vscode/
*.iml
*.ipr
*.iws
*.swp

# --- Sistem operasi ---
.DS_Store
Thumbs.db
desktop.ini

# --- Log & keluaran sementara ---
*.log
*.tmp
*.bak
